{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-record.schema.json",
  "type": "object",
  "description": "Fields of the decision record (state.md#2.8), cycles/<cycle>/decisions/<id>.json.",
  "properties": {
    "id": {"type": "string"},
    "kind": {"type": "string", "description": "One of the nine kinds in tables/decision-kinds.toml."},
    "status": {"type": "string", "enum": ["open", "approved", "revise", "rejected", "stale"]},
    "choice": {"type": "string"},
    "values": {
      "type": "object",
      "description": "The key=value pairs of the choice.",
      "additionalProperties": {"type": "string"}
    },
    "note": {"type": "string"},
    "digest": {"type": "string", "description": "16 hex characters; see topic:digests."},
    "opened": {"type": "string", "description": "ISO 8601, UTC."},
    "settled": {"type": "string", "description": "ISO 8601, UTC; empty while open."},
    "settled_by": {"type": "string", "enum": ["session", "terminal", "import"]},
    "settled_by_session": {"type": "string"},
    "reason": {
      "type": "string",
      "enum": ["spike_limit", "environment", "stuck", "reviewer"],
      "description": "For a blocked decision."
    },
    "files": {
      "type": "array",
      "items": {"type": "string"},
      "description": "A spec decision: the paths the digest covers."
    },
    "accepted": {
      "type": "array",
      "items": {"type": "string"},
      "description": "A spec decision: the ids of the decision records it accepted."
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "A merge decision: the names and versions it approved."
    }
  },
  "required": ["id", "kind", "status", "opened"]
}
